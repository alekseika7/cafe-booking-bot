# Скопируйте этот шаблон в .env рядом с config.toml и заполните значения.
# В Git хранится example_env; файл .env с реальными данными исключён из Git.

# ОБЯЗАТЕЛЬНО: контакты гостя. Для --live замените все примеры своими данными.
# Имя гостя.
GUEST_FIRST_NAME='Иван'
# Фамилия гостя.
GUEST_LAST_NAME='Иванов'
# Российский телефон: +7…, 8… или 10 цифр. Бот нормализует его в +7….
GUEST_PHONE='+79991234567'
# Email гостя.
GUEST_EMAIL='ivan@example.com'
# Telegram-логин гостя для ресторана, например @username.
GUEST_TELEGRAM='@username'

# НЕОБЯЗАТЕЛЬНО: уведомления в Telegram. Для их включения нужны ОБА значения.
# Токен Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=''
# ID чата получателя; для личного чата сначала отправьте боту /start.
TELEGRAM_CHAT_ID=''

# НЕОБЯЗАТЕЛЬНО, только Docker: UID пользователя контейнера (по умолчанию 10001).
# Для доступа к config.toml с правами 600 укажите UID владельца файла (команда id -u).
# BOOKING_UID=10001
